# Placeholder names only. No credentials are included.
# Inject values securely into the build/runtime process; the backend does not
# automatically load this template. Never place server secrets in VITE_* keys.
NODE_ENV=production
PORT=5000
DATABASE_URL=
SESSION_SECRET=

# Preserve the current Clerk tenant. Review direct/proxy mode before setting
# these; use matching publishable and private keys from the same tenant.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
VITE_USE_DIRECT_CLERK=
VITE_EXTERNAL_CLERK_PUBLISHABLE_KEY=
EXTERNAL_CLERK_SECRET_KEY=
VITE_CLERK_PROXY_URL=
CLERK_WEBHOOK_SECRET=

# Catalog source is currently hardcoded in server/staff-catalog.ts.
STAFF_API_KEY=
CONCORDIA_RX_API_KEY=
CONCORDIA_CARE_APP_URL=
CONCORDIA_WEBSITE_URL=
CONCORDIA_WEBSITE_API_KEY=
VITE_CONCORDIA_CARE_APP_URL=

# Enable only the external services you use.
PHARMFLOWS_API_KEY=
PHARMFLOWS_PHARMACY_CODE=
RESEND_API_KEY=
EMAIL_FROM=
FLU_SHOT_REVIEW_URL=
OPENAI_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_PHONE_NUMBER=
PRIMERX_API_URL=
PRIMERX_CLIENT_ID=
PRIMERX_CLIENT_SECRET=
PRIMERX_MEMBER_ID=
PRIMERX_PHARMACY_NPI=
ADMIN_NOTIFICATION_EMAIL=
PHARMACY_TEAM_EMAIL=
PHARMACY_TEAM_SMS=

# These EXISTING Replit storage settings do not configure S3.
# Storage code must be ported/configured separately before AWS uploads work.
PUBLIC_OBJECT_SEARCH_PATHS=
PRIVATE_OBJECT_DIR=
